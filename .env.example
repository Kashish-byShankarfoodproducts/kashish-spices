# ==============================================================================
# KASHISH MASALE & SPICES - Environment Variables
# ==============================================================================
# Cloudflare Pages / Local Environment Configuration
#
# Supabase Cloud Database (For Realtime Live Sync across all devices):
# 1. supabase.com par jakar free account banayein aur New Project banayein.
# 2. Project Settings > API se Project URL aur anon public key copy karein:

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Note: Agar aap Cloudflare Pages par deploy kar rahe hain,
# toh Cloudflare Pages Dashboard > Settings > Environment Variables me
# ye dono keys add kar sakte hain.
# Ya fir direct Admin Panel > "Live Cloud Sync" tab se bhi paste kar sakte hain!
